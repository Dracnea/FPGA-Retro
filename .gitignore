# Vivado / LiteX build output
build/
*.jou
*.log
.Xil/
__pycache__/
*.pyc

# Build output is not tracked -- except the images promoted into bitstreams/,
# which are kept so a card can be brought up without a Vivado seat.
*.bit
!bitstreams/*.bit
*.mcs
*.ltx
csr.csv
analyzer.csv
build_id.v
build_id.vh

venv/

# compiled test tools
tools/frametest/frametest

# Simulation scratch. run_sim.sh does `rm -rf work` and regenerates everything
# in it, including the .v/.sv the generators emit -- so nothing under work/ can
# be tracked without a sim run deleting it.
overlay/rtl/*/sim/work/
